# --- Required ---
LIMITLESS_API_KEY=            # Limitless app → Settings → Developer → API key
ANTHROPIC_API_KEY=            # console.anthropic.com
DATABASE_URL=                 # Neon Postgres connection string (Vercel → Storage → Neon)
APP_PASSWORD=                 # password for the web app login
CRON_SECRET=                  # random string; Vercel sends it to cron routes automatically

# --- Settings ---
TIMEZONE=America/New_York     # your day boundaries + timestamps
TELEGRAM_HOUR=21              # local hour the recap is sent (21 = 9pm)
CLAUDE_MODEL=claude-opus-5-5
APP_URL=                      # e.g. https://limitless-daily.vercel.app (used for links in Telegram)

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=           # from @BotFather
TELEGRAM_CHAT_ID=             # your chat id (message the bot, then see README)

# --- Obsidian via GitHub (optional) ---
OBSIDIAN_GITHUB_REPO=         # owner/repo of your vault repo (synced with the Obsidian Git plugin)
OBSIDIAN_GITHUB_TOKEN=        # fine-grained PAT with Contents: read/write on that repo
OBSIDIAN_GITHUB_BRANCH=main
OBSIDIAN_FOLDER=Limitless
